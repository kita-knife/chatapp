APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_BASE_URL=http://localhost:5173

# ---------- Postgres ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=chatapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgreswsl

# ---------- Primary LLM (OpenAI-compatible: MiniMax-M3) ----------
LLM_API_BASE=https://api.minimax.chat/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3

# ---------- Optional alt providers ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default model identifiers (shown in the UI picker)
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
OLLAMA_DEFAULT_MODEL=llama3.2

# ---------- User / auth ----------
MAX_ROOT_USERS=4
ROOT_USERNAME_MIN_LEN=3
ROOT_PASSWORD_MIN_LEN=8
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
